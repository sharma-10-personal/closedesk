# Copy to `.env` and fill in. Never commit `.env`.
# The demo runs with LLM_PROVIDER=none (no API key required).

# Exasol Personal connection (from `exasol connect` / `exasol status`)
EXA_DSN=localhost:8563
EXA_USER=sys
EXA_PASSWORD=exasol
EXA_SCHEMA=CLOSEDESK

# Read-only user used by the explanation agent. Created by `make setup`.
EXA_RO_USER=closedesk_reader
EXA_RO_PASSWORD=change-me

# LLM for plain-language explanations. Use `none` for template fallback.
# Values: none | anthropic | openai | gemini | ollama
LLM_PROVIDER=none
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434

# Scenario
CLOSEDESK_SCENARIO=config/scenario.yaml
CLOSEDESK_POLICY=config/policy.yaml
